  {
   "cell_type": "markdown",
   "id": "a5f15625",
   "metadata": {},
   "source": [
    "Similarity Functions (Cosine / Dot / neg-L2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "09a9ce86",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_scores(q_vec: np.ndarray, X: np.ndarray, metric: str) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Returns a score vector where higher is better.\n",
    "    \"\"\"\n",
    "    if metric == \"cosine\":\n",
    "        return X @ q_vec\n",
    "\n",
    "    if metric == \"dot\":\n",
    "        return X @ q_vec\n",
    "\n",
    "    if metric == \"neg_l2\":\n",
    "        # -(||x-q||^2) => higher is better\n",
    "        x2 = np.sum(X * X, axis=1)\n",
    "        q2 = float(np.sum(q_vec * q_vec))\n",
    "        return -(x2 + q2 - 2.0 * (X @ q_vec))\n",
    "\n",
    "    raise ValueError(f\"Unknown metric: {metric}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4e4b8a3e",
   "metadata": {},
   "source": [
    "Evaluation Metrics (Precision/Recall/NDCG/MRR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "d841c0ab",
   "metadata": {},
   "outputs": [],
   "source": [
    "def precision_at_k(rels: np.ndarray, k: int) -> float:\n",
    "    return float(np.sum(rels[:k])) / float(k)\n",
    "\n",
    "def recall_at_k(rels: np.ndarray, k: int, total_relevant: int) -> float:\n",
    "    if total_relevant <= 0:\n",
    "        return 0.0\n",
    "    return float(np.sum(rels[:k])) / float(total_relevant)\n",
    "\n",
    "def dcg_at_k(rels: np.ndarray, k: int) -> float:\n",
    "    rels_k = rels[:k]\n",
    "    denom = np.log2(np.arange(2, k + 2))\n",
    "    return float(np.sum(rels_k / denom))\n",
    "\n",
    "def ndcg_at_k(rels: np.ndarray, k: int) -> float:\n",
    "    dcg = dcg_at_k(rels, k)\n",
    "    ideal = np.sort(rels)[::-1]\n",
    "    idcg = dcg_at_k(ideal, k)\n",
    "    return 0.0 if idcg == 0 else (dcg / idcg)\n",
    "\n",
    "def mrr_at_k(rels: np.ndarray, k: int) -> float:\n",
    "    rels_k = rels[:k]\n",
    "    idx = np.where(rels_k == 1)[0]\n",
    "    return 0.0 if len(idx) == 0 else (1.0 / float(idx[0] + 1))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7d6a2d1d",
   "metadata": {},
   "source": [
    "Build Soft Class Probabilities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ee4b2ceb",
   "metadata": {},
   "outputs": [],
   "source": [
    "def cv_soft_probabilities(\n",
    "    X: np.ndarray,\n",
    "    y: np.ndarray,\n",
    "    n_splits: int = 5,\n",
    "    random_state: int = 42\n",
    ") -> Tuple[np.ndarray, np.ndarray, Dict]:\n",
    "    \"\"\"\n",
    "    Out-of-fold probabilities for each sample (avoid leakage).\n",
    "    Returns:\n",
    "      P: (N, C) probabilities\n",
    "      classes: array of class labels\n",
    "      meta: dict including class_to_index\n",
    "    \"\"\"\n",
    "    classes = np.unique(y)\n",
    "    class_to_index = {c: j for j, c in enumerate(classes)}\n",
    "    C = len(classes)\n",
    "    N = len(y)\n",
    "\n",
    "    P = np.zeros((N, C), dtype=np.float32)\n",
    "\n",
    "    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=random_state)\n",
    "    for train_idx, test_idx in skf.split(X, y):\n",
    "        Xtr, Xte = X[train_idx], X[test_idx]\n",
    "        ytr = y[train_idx]\n",
    "\n",
    "        clf = LogisticRegression(\n",
    "            max_iter=2000\n",
    "        )\n",
    "        clf.fit(Xtr, ytr)\n",
    "        proba = clf.predict_proba(Xte)  # columns aligned with clf.classes_\n",
    "\n",
    "        # align to global classes order\n",
    "        for j, c in enumerate(clf.classes_):\n",
    "            P[test_idx, class_to_index[c]] = proba[:, j].astype(np.float32)\n",
    "\n",
    "    meta = {\"class_to_index\": class_to_index}\n",
    "    return P, classes, meta"
   ]
  },
