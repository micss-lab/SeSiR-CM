   "metadata": {},
   "outputs": [],
   "source": [
    "emb_folder = \"\Embeddings\"\n",
    "EMBEDDING_FILES = {\n",
    "    \"bert_finetuned\": emb_folder + \"\\\\bert_finetuned_embeddings.xlsx\",\n",
    "    \"gemini\": emb_folder + \"\\\\Gemini_Embedding.xlsx\",\n",
    "    \"qwen3_8b\": emb_folder + \"\\\\Qwen3_Embedding_8B.xlsx\",\n",
    "    \"sbert\": emb_folder + \"\\\\SBERT_Embedding_2_classification.xlsx\",\n",
    "}"
   ]
  },
