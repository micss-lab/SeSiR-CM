  {
   "cell_type": "markdown",
   "id": "4d56d051",
   "metadata": {},
   "source": [
    "Cell 9 — Soft Filtering Retrieval + Evaluation (on the same SBERT)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "105ab933",
   "metadata": {},
   "outputs": [],
   "source": [
    "def soft_filtering_retrieval_eval(\n",
    "    X: np.ndarray, y: np.ndarray, ids: np.ndarray,\n",
    "    P: np.ndarray, classes: np.ndarray, class_to_index: Dict,\n",
    "    class_topk: int, beta: float,\n",
    "    topk_list: List[int], metrics: List[str],\n",
    "    normalize_for_cosine: bool = True\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    For each item as query:\n",
    "      - choose top-k classes by P(q)\n",
    "      - search only within those classes\n",
    "      - score = similarity * p(class)^beta\n",
    "      - compute IR metrics (relevant = same label)\n",
    "    \"\"\"\n",
    "    N = X.shape[0]\n",
    "    X_cos = normalize(X, axis=1) if normalize_for_cosine else X\n",
    "\n",
    "    rows = []\n",
    "    maxK = max(topk_list)\n",
    "\n",
    "    for metric in metrics:\n",
    "        X_use = X_cos if (metric == \"cosine\" and normalize_for_cosine) else X\n",
    "\n",
    "        for i in range(N):\n",
    "            q = X_use[i]\n",
    "            p = P[i]\n",
    "\n",
    "            # Top-k classes for this query\n",
    "            k_eff = min(class_topk, len(p))\n",
    "            top_class_idx = np.argpartition(-p, k_eff - 1)[:k_eff]\n",
    "            top_class_idx = top_class_idx[np.argsort(-p[top_class_idx])]\n",
    "            top_classes = classes[top_class_idx]\n",
    "\n",
    "            # candidate set: only models in these classes\n",
    "            cand_idx = np.where(np.isin(y, top_classes))[0]\n",
    "            if len(cand_idx) == 0:\n",
    "                continue\n",
    "\n",
    "            # similarity scores inside candidate set\n",
    "            scores = compute_scores(q, X_use[cand_idx], metric)\n",
    "\n",
    "            # exclude self\n",
    "            where_self = np.where(cand_idx == i)[0]\n",
    "            if len(where_self) > 0:\n",
    "                scores[where_self[0]] = -np.inf\n",
    "\n",
    "            # multiply by class prob^beta\n",
    "            cand_labels = y[cand_idx]\n",
    "            cand_p = np.array([p[class_to_index[lab]] for lab in cand_labels], dtype=np.float32)\n",
    "            scores = scores * np.power(cand_p, beta)\n",
    "\n",
    "            # retrieve top maxK\n",
    "            Ktake = min(maxK, len(scores))\n",
    "            top_local = np.argpartition(-scores, Ktake - 1)[:Ktake]\n",
    "            top_local = top_local[np.argsort(-scores[top_local])]\n",
    "            top_global = cand_idx[top_local]\n",
    "\n",
    "            rel = (y[top_global] == y[i]).astype(np.int32)\n",
    "            total_rel = int(np.sum(y == y[i]) - 1)\n",
    "\n",
    "            for K in topk_list:\n",
    "                Ke = min(K, len(rel))\n",
    "                rows.append({\n",
    "                    \"method\": f\"soft_filter_top{class_topk}_beta{beta}\",\n",
    "                    \"metric\": metric,\n",
    "                    \"query_id\": ids[i],\n",
    "                    \"query_label\": int(y[i]),\n",
    "                    \"K\": int(K),\n",
    "                    \"precision@K\": precision_at_k(rel, Ke),\n",
    "                    \"recall@K\": recall_at_k(rel, Ke, total_rel),\n",
    "                    \"ndcg@K\": ndcg_at_k(rel, Ke),\n",
    "                    \"mrr@K\": mrr_at_k(rel, Ke),\n",
    "                })\n",
    "\n",
    "    return pd.DataFrame(rows)"
   ]
  },
