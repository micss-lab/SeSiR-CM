   "source": [
    "all_perquery = []\n",
    "\n",
    "for emb_name, path in EMBEDDING_FILES.items():\n",
    "    print(f\"\\n=== Running Soft Filtering for: {emb_name} ===\")\n",
    "    if not os.path.exists(path):\n",
    "        print(\"File not found:\", path)\n",
    "        continue\n",
    "\n",
    "    df, X, y, ids = load_embedding_xlsx(path)\n",
    "\n",
    "    # Step A: out-of-fold soft probabilities\n",
    "    P, classes, meta = cv_soft_probabilities(X, y, n_splits=N_SPLITS, random_state=RANDOM_STATE)\n",
    "    class_to_index = meta[\"class_to_index\"]\n",
    "\n",
    "    # Step B: soft filtering retrieval + evaluation\n",
    "    t0 = time.time()\n",
    "    perq = soft_filtering_retrieval_eval(\n",
    "        X=X, y=y, ids=ids,\n",
    "        P=P, classes=classes, class_to_index=class_to_index,\n",
    "        class_topk=CLASS_TOPK, beta=BETA,\n",
    "        topk_list=TOPK_LIST, metrics=SIM_METRICS,\n",
    "        normalize_for_cosine=True\n",
    "    )\n",
    "    perq.insert(0, \"embedding\", emb_name)  # add embedding name\n",
    "    all_perquery.append(perq)\n",
    "\n",
    "    print(\"per-query rows:\", len(perq), \"| seconds:\", round(time.time() - t0, 2))\n",
    "\n",
    "df_perquery = pd.concat(all_perquery, ignore_index=True)\n",
    "print(\"\\nALL DONE. Total rows:\", len(df_perquery))\n",
    "df_perquery.head()"
   ]
  },
