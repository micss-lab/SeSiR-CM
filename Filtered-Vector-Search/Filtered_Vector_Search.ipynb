  {
   "cell_type": "markdown",
   "id": "afb2216d",
   "metadata": {},
   "source": [
    "Cell 3 — Loader ( compatible with embeddings)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "e6742b17",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from typing import Tuple\n",
    "\n",
    "def is_numeric_col_name(c) -> bool:\n",
    "    if isinstance(c, (int, np.integer)):\n",
    "        return True\n",
    "    s = str(c)\n",
    "    return s.isdigit()\n",
    "\n",
    "def load_embedding_xlsx(path: str) -> Tuple[pd.DataFrame, np.ndarray, np.ndarray, np.ndarray]:\n",
    "    df = pd.read_excel(path, engine=\"openpyxl\")\n",
    "\n",
    "    # label column\n",
    "    label_candidates = [c for c in df.columns if str(c).lower() in (\"label\", \"y\", \"class\")]\n",
    "    if not label_candidates:\n",
    "        raise ValueError(f\"[{path}] No label column found.\")\n",
    "    label_col = label_candidates[0]\n",
    "\n",
    "    # id column\n",
    "    id_candidates = [c for c in df.columns if str(c).lower() in (\"filename\", \"file\", \"text_file\", \"id\", \"file_id\")]\n",
    "    if id_candidates:\n",
    "        preferred = [c for c in id_candidates if str(c).lower() in (\"filename\", \"file\", \"text_file\")]\n",
    "        id_col = preferred[0] if preferred else id_candidates[0]\n",
    "    else:\n",
    "        non_num = [c for c in df.columns if c != label_col and not is_numeric_col_name(c)]\n",
    "        if not non_num:\n",
    "            raise ValueError(f\"[{path}] No id-like column found.\")\n",
    "        id_col = non_num[0]\n",
    "\n",
    "    # embedding columns (numeric OR e0..eN)\n",
    "    emb_cols = [c for c in df.columns if c != label_col and is_numeric_col_name(c)]\n",
    "    if not emb_cols:\n",
    "        emb_cols = [c for c in df.columns\n",
    "                    if c != label_col and str(c).lower().startswith(\"e\") and str(c)[1:].isdigit()]\n",
    "\n",
    "    if not emb_cols:\n",
    "        raise ValueError(f\"[{path}] No embedding columns found. Columns: {df.columns.tolist()[:30]}\")\n",
    "\n",
    "    X = df[emb_cols].to_numpy(dtype=np.float32)\n",
    "    y = df[label_col].to_numpy()\n",
    "    ids = df[id_col].astype(str).to_numpy()\n",
    "\n",
    "    return df, X, y, ids"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "eda987e5",
   "metadata": {},
   "source": [
    "Cell 4 — IR metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "10b4e30d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def precision_at_k(rels: np.ndarray, k: int) -> float:\n",
    "    return float(np.sum(rels[:k])) / float(k)\n",
    "\n",
    "def recall_at_k(rels: np.ndarray, k: int, total_relevant: int) -> float:\n",
    "    if total_relevant <= 0:\n",
    "        return 0.0\n",
    "    return float(np.sum(rels[:k])) / float(total_relevant)\n",
    "\n",
    "def dcg_at_k(rels: np.ndarray, k: int) -> float:\n",
    "    rels_k = rels[:k]\n",
    "    denom = np.log2(np.arange(2, k + 2))\n",
    "    return float(np.sum(rels_k / denom))\n",
    "\n",
    "def ndcg_at_k(rels: np.ndarray, k: int) -> float:\n",
    "    dcg = dcg_at_k(rels, k)\n",
    "    ideal = np.sort(rels)[::-1]\n",
    "    idcg = dcg_at_k(ideal, k)\n",
    "    return 0.0 if idcg == 0 else (dcg / idcg)\n",
    "\n",
    "def mrr_at_k(rels: np.ndarray, k: int) -> float:\n",
    "    rels_k = rels[:k]\n",
    "    idx = np.where(rels_k == 1)[0]\n",
    "    return 0.0 if len(idx) == 0 else (1.0 / float(idx[0] + 1))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3ca589b6",
   "metadata": {},
   "source": [
    "Cell 5 — Similarities + Class Thresholds + Filtered Static Search (Leave-One-Out)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "4e236f33",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import normalize\n",
    "\n",
    "def compute_class_thresholds_cosine(X: np.ndarray, y: np.ndarray, alpha: float = 1.0) -> Dict[int, float]:\n",
    "    \"\"\"\n",
    "    Compute class-adaptive thresholds:\n",
    "      T_L = mu_L - alpha * sigma_L\n",
    "    where mu_L, sigma_L are computed over all intra-class cosine similarities (pairwise, excluding diagonal).\n",
    "    \"\"\"\n",
    "    Xn = normalize(X, axis=1).astype(np.float32)\n",
    "    thresholds: Dict[int, float] = {}\n",
    "\n",
    "    labels = np.unique(y)\n",
    "    for L in labels:\n",
    "        idx = np.where(y == L)[0]\n",
    "        Xc = Xn[idx]\n",
    "        nc = Xc.shape[0]\n",
    "\n",
    "        # If a class has <2 items, threshold is not meaningful; set very low to accept all\n",
    "        if nc < 2:\n",
    "            thresholds[int(L)] = -1.0\n",
    "            continue\n",
    "\n",
    "        # cosine similarity matrix within class\n",
    "        S = Xc @ Xc.T  # (nc, nc)\n",
    "        iu = np.triu_indices(nc, k=1)  # upper triangle, exclude diagonal\n",
    "        vals = S[iu]\n",
    "\n",
    "        mu = float(vals.mean())\n",
    "        sigma = float(vals.std(ddof=0))\n",
    "        thresholds[int(L)] = mu - alpha * sigma\n",
    "\n",
    "    return thresholds\n",
    "\n",
    "\n",
    "def scores_for_metric(q: np.ndarray, X: np.ndarray, metric: str) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Return scores where larger is better.\n",
    "    - cosine: assumes q and X are already L2-normalized\n",
    "    - dot: raw inner product\n",
    "    - neg_l2: negative squared L2 distance\n",
    "    \"\"\"\n",
    "    if metric == \"cosine\":\n",
    "        return X @ q\n",
    "    if metric == \"dot\":\n",
    "        return X @ q\n",
    "    if metric == \"neg_l2\":\n",
    "        x2 = np.sum(X * X, axis=1)\n",
    "        q2 = float(np.sum(q * q))\n",
    "        return -(x2 + q2 - 2.0 * (X @ q))\n",
    "    raise ValueError(f\"Unknown metric: {metric}\")\n",
    "\n",
    "\n",
    "def filtered_static_threshold_eval(\n",
    "    X: np.ndarray, y: np.ndarray, ids: np.ndarray,\n",
    "    topk_list: List[int],\n",
    "    sim_metrics: List[str],\n",
    "    alpha: float = 1.0\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    Leave-one-out evaluation:\n",
    "      - static filter: restrict candidates to same true label as query\n",
    "      - retrieve Top-K within filtered set using each similarity metric\n",
    "      - compute Precision/Recall/NDCG/MRR (same as previous experiments)\n",
    "      - additionally compute Threshold-Precision@K (based on cosine threshold T_L)\n",
    "    \"\"\"\n",
    "    X = np.asarray(X, dtype=np.float32)\n",
    "    y = np.asarray(y)\n",
    "    N, d = X.shape\n",
    "    maxK = max(topk_list)\n",
    "\n",
    "    # Precompute normalized vectors for cosine (used for thresholds + cosine retrieval + threshold eval)\n",
    "    Xn = normalize(X, axis=1).astype(np.float32)\n",
    "\n",
    "    # Thresholds per class (based on cosine similarities inside each class)\n",
    "    T = compute_class_thresholds_cosine(X, y, alpha=alpha)\n",
    "\n",
    "    # Build per-class index lists (static filter)\n",
    "    class_to_indices: Dict[int, np.ndarray] = {}\n",
    "    for L in np.unique(y):\n",
    "        class_to_indices[int(L)] = np.where(y == L)[0]\n",
    "\n",
    "    rows = []\n",
    "\n",
    "    for i in range(N):\n",
    "        L = int(y[i])\n",
    "        cand = class_to_indices[L]\n",
    "        cand = cand[cand != i]  # leave-one-out: remove self\n",
    "\n",
    "        if cand.size == 0:\n",
    "            continue\n",
    "\n",
    "        total_rel = int(cand.size)  # within-class relevant count (all candidates are same label)\n",
    "        Ktake = min(maxK, cand.size)\n",
    "\n",
    "        # --- For each similarity metric, retrieve Top-K within the filtered class ---\n",
    "        for metric in sim_metrics:\n",
    "            if metric == \"cosine\":\n",
    "                q = Xn[i]\n",
    "                Xc = Xn[cand]\n",
    "            else:\n",
    "                q = X[i]\n",
    "                Xc = X[cand]\n",
    "\n",
    "            sc = scores_for_metric(q, Xc, metric)  # higher better\n",
    "            top_local = np.argpartition(-sc, Ktake - 1)[:Ktake]\n",
    "            top_local = top_local[np.argsort(-sc[top_local])]\n",
    "            top_global = cand[top_local]\n",
    "\n",
    "            # Relevance vector (will be all ones, but we compute uniformly for compatibility)\n",
    "            rel = (y[top_global] == y[i]).astype(np.int32)\n",
    "\n",
    "            for K in topk_list:\n",
    "                Ke = min(K, len(rel))\n",
    "                rows.append({\n",
    "                    \"method\": \"filtered_static_threshold\",\n",
    "                    \"metric\": metric,\n",
    "                    \"query_id\": ids[i],\n",
    "                    \"query_label\": L,\n",
    "                    \"K\": int(K),\n",
    "                    \"precision@K\": precision_at_k(rel, Ke),\n",
    "                    \"recall@K\": recall_at_k(rel, Ke, total_rel),\n",
    "                    \"ndcg@K\": ndcg_at_k(rel, Ke),\n",
    "                    \"mrr@K\": mrr_at_k(rel, Ke),\n",
    "                    \"threshold_precision@K\": np.nan,\n",
    "                    \"threshold_TL\": np.nan,\n",
    "                })\n",
    "\n",
    "        # --- Threshold evaluation (defined on cosine) ---\n",
    "        # We compute Threshold-Precision@K on cosine-ranked list (top-K within class)\n",
    "        q = Xn[i]\n",
    "        Xc = Xn[cand]\n",
    "        sc_cos = scores_for_metric(q, Xc, \"cosine\")\n",
    "        top_local = np.argpartition(-sc_cos, Ktake - 1)[:Ktake]\n",
    "        top_local = top_local[np.argsort(-sc_cos[top_local])]\n",
    "        top_scores = sc_cos[top_local]  # cosine scores for top neighbors\n",
    "\n",
    "        TL = float(T[L])\n",
    "        for K in topk_list:\n",
    "            Ke = min(K, len(top_scores))\n",
    "            tp = float(np.mean(top_scores[:Ke] >= TL)) if Ke > 0 else np.nan\n",
    "\n",
    "            rows.append({\n",
    "                \"method\": \"filtered_static_threshold\",\n",
    "                \"metric\": \"cosine_threshold\",  # جداگانه برای خوانایی در Summary/Charts\n",
    "                \"query_id\": ids[i],\n",
    "                \"query_label\": L,\n",
    "                \"K\": int(K),\n",
    "                \"precision@K\": np.nan,\n",
    "                \"recall@K\": np.nan,\n",
    "                \"ndcg@K\": np.nan,\n",
    "                \"mrr@K\": np.nan,\n",
    "                \"threshold_precision@K\": tp,\n",
    "                \"threshold_TL\": TL,\n",
    "            })\n",
    "\n",
    "    return pd.DataFrame(rows)"
   ]
  },
