    "# ---- Input embedding files (same 4 embeddings) ----\n",
    "emb_folder = \"\Embeddings\"\n",
    "EMBEDDING_FILES = {\n",
    "    \"bert_finetuned\": emb_folder + \"\\\\bert_finetuned_embeddings.xlsx\",\n",
    "    \"gemini\": emb_folder + \"\\\\Gemini_Embedding.xlsx\",\n",
    "    \"qwen3_8b\": emb_folder + \"\\\\Qwen3_Embedding_8B.xlsx\",\n",
    "    \"sbert\": emb_folder + \"\\\\SBERT_Embedding_2_classification.xlsx\",\n",
    "}\n",
    "\n",
    "# ---- Evaluation cutoffs (same as previous experiments) ----\n",
    "TOPK_LIST = [1, 5, 10, 20]\n",
    "\n",
    "# ---- Similarity metrics (same as previous experiments) ----\n",
    "SIM_METRICS = [\"cosine\", \"dot\", \"neg_l2\"]  # higher is better for all\n",
    "\n",
    "# ---- Threshold definition (class-adaptive) ----\n",
    "# T_L = mu_L - alpha * sigma_L  (alpha=1 => your current design)\n",
    "THRESH_ALPHA = 1.0\n",
    "\n",
    "# ---- Output Excel ----\n",
    "OUT_XLSX = \"filtered_static_threshold_results.xlsx\""
